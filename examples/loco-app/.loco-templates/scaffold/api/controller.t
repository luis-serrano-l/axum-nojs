#[debug_handler]
async fn update(
{% if auth %}    _auth: auth::JWT,
{% endif %}    ui: Ui,
    State(ctx): State<AppContext>,
    Path(id): Path<i64>,
    Valid(form): Valid<Params>,
) -> Result<Response> {
    let item = load(&ctx, id).await?;
    let action = format!("/{{ snake_plural }}/{id}");
    let p = match form {
        Ok(p) => p,
        Err(bad) => {
            let title = "Edit {{ snake_singular | replace(from="_", to=" ") }}";
            let body = views::{{ snake_plural }}::form(&ui, title, &action, &bad.values, &bad.errors.pairs(), &refs(&ctx).await?);
            return Ok(ui.page(title, body).into_response());
        }
    };
    let mut item = item.into_active_model();
    set(&mut item, p);
    item.update(&ctx.db).await?;
    Ok(ui.redirect(&action).ok("Saved.").into_response())
}

#[debug_handler]
async fn remove(
{% if auth %}    _auth: auth::JWT,
{% endif %}    ui: Ui,
    State(ctx): State<AppContext>,
    Path(id): Path<i64>,
) -> Result<Redirect> {
    load(&ctx, id).await?.into_active_model().delete(&ctx.db).await?;
    Ok(ui.redirect("/{{ snake_plural }}").ok("Deleted."))
}

pub fn routes() -> Routes {
    Routes::new()
        .prefix("/{{ snake_plural }}")
        .add("/", get(list).post(create))
        .add("/new", get(new))
        .add("/{id}", get(show).post(update))
        .add("/{id}/edit", get(edit))
        .add("/{id}/delete", post(remove))
}
